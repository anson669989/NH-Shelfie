{
  "name": "nh-shelfie",
  "private": true,
  "version": "0.1.0",
  "description": "NH 本地收藏管理器：在手機本地管理收藏的 gallery ID 與封面，不經任何自建伺服器。",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "test": "vitest run",
    "android:prepare": "npm run build && (test -d android || npx cap add android) && node scripts/patch-android.mjs && npx cap sync android",
    "android:open": "npx cap open android"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor/android": "^7.0.0",
    "@capacitor/app": "^7.0.0",
    "@capacitor/browser": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/filesystem": "^7.0.0",
    "@capacitor/share": "^7.0.0",
    "nh-webfetch": "file:plugins/nh-webfetch",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@vitejs/plugin-vue": "^5.2.0",
    "vite": "^6.3.0",
    "vitest": "^3.2.0"
  }
}
