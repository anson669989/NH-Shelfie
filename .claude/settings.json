{
  "permissions": {
    "allow": [
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npm run android:prepare)",
      "Bash(npm install)",
      "Bash(git status)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./**/*.jks)",
      "Read(./**/*.keystore)",
      "Read(./keystore.properties)",
      "Bash(git push --force:*)"
    ]
  }
}
